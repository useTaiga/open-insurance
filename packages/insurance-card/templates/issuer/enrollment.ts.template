import { readFile } from "node:fs/promises";
import { z } from "zod";
import { parseEnrollment } from "open-insurance/integration";
import type { Enrollment } from "open-insurance/integration";

export const createEnrollmentLoader =
  (payerId: string, name: string) =>
  async (memberKey: string): Promise<Enrollment | undefined> => {
    const records = z
      .record(z.string(), z.unknown())
      .parse(JSON.parse(await readFile(new URL("./enrollments.json", import.meta.url), "utf8")));
    const record = records[memberKey];
    if (!record) {
      return undefined;
    }
    return parseEnrollment(record, { payerId, name });
  };
