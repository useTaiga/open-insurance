<!doctype html>
<html lang="en">
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Insurance issuer reference</title>
<style>
:root{--brand:#6d39d9;font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#202522;background:#f6f7f6}*{box-sizing:border-box}body{margin:0}main{max-width:1060px;margin:auto;padding:48px 24px}header{margin-bottom:32px}h1{font-size:32px;letter-spacing:-.04em;margin:8px 0}h2{font-size:18px;margin:0 0 16px}p{color:#606761;margin:8px 0 20px}.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#656c66}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}section{background:white;border:1px solid #e1e5e1;border-radius:16px;padding:24px;min-width:0}.wide{grid-column:1/-1}.row{display:flex;flex-wrap:wrap;align-items:center;gap:10px}button,select,a.button{font:inherit;font-size:14px;border:1px solid #d9ded9;border-radius:8px;background:white;color:#252925;padding:10px 14px;cursor:pointer;text-decoration:none}button.primary,a.primary{background:#18231d;border-color:#18231d;color:white}button:disabled,a[aria-disabled=true]{opacity:.4;pointer-events:none}button:hover:not(:disabled),a.button:hover{filter:brightness(.94)}:focus-visible{outline:3px solid #c5b1ef;outline-offset:3px}.card{background:var(--brand);color:white;padding:24px;border-radius:16px;margin:20px 0;min-height:210px}.card small{opacity:.8;font-size:11px;letter-spacing:.08em}.card strong{display:block;font-size:26px;margin:16px 0 24px;font-weight:500}.card span{font-size:14px}.status{font-size:13px;margin-bottom:14px;color:#626962}.check{padding:10px 0;border-top:1px solid #edf0ed;font-size:13px}.check b{font-size:10px;letter-spacing:.05em;display:block;color:#7a551c}.check[data-status=ready] b{color:#236848}pre{background:#f5f6f5;border-radius:8px;padding:16px;font:12px/1.6 ui-monospace,monospace;max-height:400px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere}details summary{cursor:pointer;font-size:14px;padding:8px 0}.footnote{font-size:12px;margin-top:24px}.message{min-height:24px;font-size:14px;color:#515952}@media(max-width:700px){.grid{grid-template-columns:1fr}main{padding:24px 16px}}
</style>
<main>
<header><div class="eyebrow">Open Insurance · Issuer reference</div><h1 id="title">Member portal → clinic intake</h1><p>Fictional enrollment. Supplied benefits. No paid eligibility requests.</p></header>
<div class="grid">
<section><h2>1. Member portal</h2><label class="eyebrow" for="member">Fictional member</label><div class="row"><select id="member"><option value="subscriber">Casey Morgan · Policyholder</option><option value="dependent">Jamie Morgan · Dependent</option></select><button id="preview" class="primary">Preview card</button></div>
<div class="card"><small id="payer">INSURANCE</small><strong id="patient">Choose a member</strong><span id="identity">Your enrollment source controls these fields.</span></div>
<div class="row"><a id="wallet" class="button primary" href="/member/pass.pkpass" aria-disabled="true">Add to Apple Wallet</a><button id="revoke" disabled>Revoke card</button></div><p class="footnote">Wallet signing and NFC readiness are checked separately. This preview is unsigned.</p></section>
<section><h2>2. Setup checker</h2><div class="status" id="readiness">Checking configuration…</div><div id="checks"></div></section>
<section class="wide"><h2>3. Clinic handoff</h2><p>Simulate an authorized clinic resolving this card. A physical tap requires Apple-authorized signing and a working VAS reader.</p><div class="row"><button id="read" class="primary" disabled>Simulate clinic read</button><span class="eyebrow">Fictional clinic · NPI 1999999984</span></div><p id="benefits-status" class="status"></p><details id="benefits-panel"><summary>Complete supplied benefits</summary><pre id="benefits">No read yet.</pre></details><details><summary>Prepared eligibility request · unsent</summary><pre id="request">No read yet.</pre></details></section>
</div><p id="message" class="message" role="status"></p><p class="footnote">Demo selectors are local fixtures. Replace enrollment and both authorization callbacks before connecting your system. Created by Taiga · MIT.</p>
</main>
<script type="module">
const $=id=>document.getElementById(id);let current;let config;
const call=async(url,options)=>{const response=await fetch(url,options);if(!response.ok){const body=await response.json();throw Error(body.error??"Request failed")}return response.status===204?undefined:response.json()};
const run=fn=>async()=>{try{$("message").textContent="";await fn()}catch(error){$("message").textContent=error.message}};
const clear=()=>{current=undefined;$("read").disabled=true;$("revoke").disabled=true;$("wallet").setAttribute("aria-disabled","true");$("benefits").textContent="No read yet.";$("request").textContent="No read yet.";$("benefits-status").textContent="";$("patient").textContent="Choose a member";$("identity").textContent="Your enrollment source controls these fields."};
$("member").onchange=clear;
$("preview").onclick=run(async()=>{clear();await call("/demo/session",{method:"POST",body:$("member").value});current=await call("/member/pass.json");$("patient").textContent=current.generic.primaryFields[0].value;$("identity").textContent="Member ID "+current.generic.secondaryFields[0].value;$("read").disabled=false;$("revoke").disabled=false;$("wallet").setAttribute("aria-disabled",String(!config.report.walletReady||(config.report.nfcConfigured&&!config.report.nfcReady)));$("message").textContent="Unsigned preview created from the enrollment adapter."});
$("read").onclick=run(async()=>{const result=await call("/clinic/read",{method:"POST",headers:{"content-type":"application/json","x-demo-clinic":"fixture"},body:JSON.stringify({message:current.serialNumber})});$("benefits").textContent=JSON.stringify(result.benefits,null,2);$("request").textContent=JSON.stringify(result.eligibilityRequest,null,2);$("benefits-status").textContent=result.benefits?`${result.benefits.freshness} · Supplied ${result.benefits.snapshot.asOf} · Expires ${result.benefits.snapshot.expiresAt}`:"No supplied benefits for this provider.";$("benefits-panel").open=true;$("message").textContent="Enrollment refreshed. Benefits retrieved. No eligibility request sent."});
$("revoke").onclick=run(async()=>{await call("/member/card",{method:"DELETE"});clear();$("message").textContent="Old reference revoked. Preview again to issue a new card."});
try{config=await call("/api/setup");$("title").textContent=config.name+" · Integration reference";$("payer").textContent=config.name+" · FICTIONAL";document.documentElement.style.setProperty("--brand",config.background??"#6d39d9");$("readiness").textContent=`Wallet signing: ${config.report.walletReady?"ready":"blocked"} · NFC: ${config.report.nfcReady?"ready for physical test":"blocked"}`;for(const check of config.report.checks){const element=document.createElement("div");element.className="check";element.dataset.status=check.status;const label=document.createElement("b");label.textContent=check.status.toUpperCase()+" · "+check.id;element.append(label,document.createTextNode(check.detail));$("checks").append(element)}}catch(error){$("message").textContent=error.message}
</script>
</html>
