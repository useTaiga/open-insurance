<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Insurance intake reference</title>
    <link rel="stylesheet" href="/portal.css">
    <script type="module" src="/portal.js"></script>
  </head>
  <body>
    <main>
      <header>
        <div class="eyebrow">Open Insurance · Developer reference</div>
        <h1 id="title">Member card → clinic intake</h1>
        <p>Fictional enrollment and supplied benefits. No eligibility inquiry is sent.</p>
      </header>
      <div class="setup-line"><span id="readiness">Checking signing setup…</span><details><summary>View setup checks</summary><div id="checks"></div></details></div>
      <div class="workspace">
        <section class="member-panel" aria-labelledby="member-heading">
          <h2 id="member-heading">Member card</h2>
          <label for="member">Fictional member</label>
          <select id="member"><option value="subscriber">Casey Morgan · Policyholder</option><option value="dependent">Jamie Morgan · Dependent</option></select>
          <button id="preview" class="primary">Load member card</button>
          <div class="card"><small id="payer">INSURANCE · FICTIONAL</small><strong id="patient">Choose a member</strong><span id="identity">Enrollment comes from the issuer.</span><span id="group"></span></div>
          <div class="actions"><a id="wallet" class="button" href="/member/pass.pkpass" aria-disabled="true">Add to Apple Wallet</a><button id="revoke" disabled>Revoke card</button></div>
          <p class="note">This preview is unsigned. Supplied coverage dates appear on the back of a signed pass.</p>
          <details id="lifecycle"><summary>Test issuer updates</summary><p class="note">These controls change only the fictional enrollment file and synchronize its existing card.</p><div class="lifecycle-actions"><button id="change" disabled>Change copay to $35</button><button id="terminate" disabled>Terminate enrollment</button><button id="restore" disabled>Restore original enrollment</button></div></details>
        </section>
        <section class="intake-panel" aria-labelledby="intake-heading">
          <div class="section-heading"><div><h2 id="intake-heading">Clinic intake</h2><span class="note">Fictional clinic · NPI 1999999984</span></div><button id="read" class="primary" disabled>Simulate card read</button></div>
          <p class="note">A real tap requires an Apple-authorized NFC pass and a working VAS reader.</p>
          <div id="empty" class="empty">Load a member card, then simulate a read to retrieve its coverage and benefits.</div>
          <div id="result" hidden>
            <div class="provenance"><strong id="freshness"></strong><span id="observed"></span><span id="snapshot-expires"></span></div>
            <p class="note">Snapshot validity describes freshness. It is separate from coverage dates and card expiration.</p>
            <div id="issues" class="issues" hidden></div>
            <h3>Coverage dates <span id="date-subject" class="subtle"></span></h3>
            <div id="coverage"></div>
            <p class="note">Benefit-specific dates below take precedence for that benefit. “Not supplied” does not mean unlimited or active coverage.</p>
            <div class="benefit-toolbar"><h3>Supplied benefits</h3><label for="filter">Show <select id="filter"><option value="all">All benefits</option><option value="statuses">Coverage status</option><option value="coPayment">Copays</option><option value="coInsurance">Coinsurance</option><option value="deductible">Deductibles</option><option value="outOfPocket">Out of pocket</option></select></label></div>
            <p class="note">Amounts remain separate by service, network, coverage level and time period. Network describes the benefit, not this clinic’s participation.</p>
            <div id="plans"></div>
            <details><summary>Complete original benefits JSON</summary><pre id="benefits"></pre></details>
            <details><summary>Prepared eligibility request · unsent</summary><pre id="request"></pre></details>
          </div>
        </section>
      </div>
      <p id="message" class="message" role="status" aria-live="polite"></p>
      <footer>Local fixture identities · Replace enrollment and authorization for a live integration · Created by Taiga · MIT</footer>
    </main>
  </body>
</html>
