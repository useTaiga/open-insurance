import { readFile, writeFile } from "node:fs/promises";
import { z } from "zod";

const recordsSchema = z.record(
  z.string(),
  z
    .object({
      status: z.enum(["active", "terminated"]),
      benefits: z
        .object({
          asOf: z.string(),
          expiresAt: z.string(),
          data: z.record(z.string(), z.json()),
        })
        .passthrough(),
    })
    .passthrough(),
);

export const updateDemoEnrollment = async (
  memberKey: string,
  action: "change-copay" | "terminate" | "restore",
) => {
  const file = new URL("./enrollments.json", import.meta.url);
  const records = recordsSchema.parse(JSON.parse(await readFile(file, "utf8")));
  const record = records[memberKey];
  if (!record || record.benefits.data.demo !== true) {
    throw new Error("Only fictional demo enrollment may be changed here.");
  }
  if (action === "restore") {
    const seed = recordsSchema.parse(
      JSON.parse(await readFile(new URL("./enrollments.seed.json", import.meta.url), "utf8")),
    );
    const original = seed[memberKey];
    if (!original || original.benefits.data.demo !== true) {
      throw new Error("Fictional seed is unavailable.");
    }
    records[memberKey] = original;
  } else if (action === "terminate") {
    record.status = "terminated";
  } else {
    const data = record.benefits.data;
    if (Array.isArray(data.benefitsInformation)) {
      for (const entry of data.benefitsInformation) {
        if (entry && typeof entry === "object" && !Array.isArray(entry) && entry.code === "B") {
          entry.benefitAmount = "35.00";
        }
      }
    }
    if (Array.isArray(data.plans)) {
      for (const value of data.plans) {
        const plan = z.object({ benefits: z.record(z.string(), z.json()) }).parse(value);
        if (Array.isArray(plan.benefits.coPayment)) {
          for (const entry of plan.benefits.coPayment) {
            if (entry && typeof entry === "object" && !Array.isArray(entry)) {
              entry.amount = "35.00";
            }
          }
        }
        if (value && typeof value === "object" && !Array.isArray(value)) {
          value.benefits = plan.benefits;
        }
      }
    }
    record.benefits.asOf = new Date().toISOString();
    record.benefits.expiresAt = new Date(Date.now() + 86_400_000).toISOString();
  }
  await writeFile(file, `${JSON.stringify(records, null, 2)}\n`, { mode: 0o600 });
};
